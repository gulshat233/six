<Window x:Class="six.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:six.ViewModels"
        Title="Метод Ньютона — решение нелинейных уравнений"
        Height="680" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock Text="Метод Ньютона"
                       Foreground="White" FontSize="18"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="15" Margin="15,15,15,0">
            <StackPanel>
                
                <Border Background="#3498DB" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Решаемое уравнение:" 
                                   Foreground="#D6EAF8" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EquationText}" 
                                   Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Начальное приближение x₀:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding X0}" Width="100" Padding="5" Margin="0,0,20,0"/>

                    <TextBlock Text="Точность ε:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Epsilon}" Width="120" Padding="5" Margin="0,0,20,0"/>

                    <Button Content="Решить" Command="{Binding SolveCommand}"
                            Width="130" Height="34" Background="#27AE60" Foreground="White"
                            BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

       
        <Border Grid.Row="2" Background="#ECF0F1" Padding="15" Margin="15,10,15,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Корень: " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ResultRoot, StringFormat=F6}" 
                           FontSize="16" FontWeight="Bold" Foreground="#27AE60"/>

                <TextBlock Text="   |   Количество итераций: " FontSize="16" Margin="30,0,0,0"/>
                <TextBlock Text="{Binding Iterations}" 
                           FontSize="16" FontWeight="Bold" Foreground="#E67E22"/>

                <TextBlock Text="{Binding ErrorMessage}" 
                           FontSize="14" Foreground="Red" Margin="30,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="15,10,15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text=" История решений :" 
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <DataGrid Grid.Row="1" ItemsSource="{Binding History}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#F9F9F9"
                      RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Уравнение" Binding="{Binding EquationText}" Width="180"/>
                    <DataGridTextColumn Header="x₀" Binding="{Binding X0}" Width="90"/>
                    <DataGridTextColumn Header="ε" Binding="{Binding Epsilon}" Width="100"/>
                    <DataGridTextColumn Header="Корень" Binding="{Binding Root, StringFormat=F6}" Width="130"/>
                    <DataGridTextColumn Header="Итераций" Binding="{Binding Iterations}" Width="90"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4" Background="#ECF0F1" Padding="10">
            <Button Content="Очистить историю" Command="{Binding ClearHistoryCommand}"
                    HorizontalAlignment="Center" Padding="15,8"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>